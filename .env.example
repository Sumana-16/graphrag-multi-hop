# Copy this file to .env and fill in your own values. Never commit .env.

# Databases (defaults match docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=graphrag_password

# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pick a model your key still has quota for (free tier is limited per day)
GEMINI_MODEL=gemini-3.1-flash-lite
